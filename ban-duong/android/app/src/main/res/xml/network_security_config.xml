<?xml version="1.0" encoding="utf-8"?>
<!-- Chỉ HTTPS, chỉ tin chứng chỉ hệ thống (không tin chứng chỉ người dùng tự cài). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
